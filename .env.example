# =============================================================================
# Nexo Analytics — variables de entorno (copia a .env.local y completa).
# NUNCA subas .env.local al repositorio ni pegues secretos en chats.
# PÚBLICAS: prefijo NEXT_PUBLIC_ (pueden llegar al navegador; no son secretas).
# SERVIDOR: todo lo demás (solo servidor y trabajador).
# Detalle de cada variable: docs/variables-de-entorno.md
# =============================================================================

# --- Aplicación (servidor) ---
APP_URL=http://localhost:3000
# true/false. En producción, sin Supabase/base de datos la demo se habilita por defecto.
DEMO_MODE_ENABLED=true

# --- Supabase ---
# PÚBLICA: URL del proyecto y clave publicable (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVIDOR (secreta): clave secreta sb_secret_... Solo para alta de cuentas invitadas y scripts.
SUPABASE_SECRET_KEY=

# --- Base de datos (servidor, secreta) ---
# Cadena de conexión Postgres de Supabase (Transaction pooler, puerto 6543, recomendado en serverless).
DATABASE_URL=
# require | no-verify | disable   (disable solo en local)
DATABASE_SSL=require
DATABASE_POOL_MAX=5

# --- Cifrado de credenciales de proveedores (servidor, secreta) ---
# Formato: id:base64(32 bytes)[,id_anterior:base64]. Genera con: npm run keys:generate -- v1
TOKEN_ENCRYPTION_KEYS=
TOKEN_ENCRYPTION_ACTIVE_KEY_ID=v1

# --- Sincronización (servidor) ---
# Secreto para /api/cron/sync (Authorization: Bearer <CRON_SECRET>). Genera uno aleatorio largo.
CRON_SECRET=
SYNC_LEASE_SECONDS=300
# Espera entre ciclos del trabajador (ms)
SYNC_IDLE_MS=30000
SYNC_CRON_TIME_BUDGET_MS=50000
# SYNC_WORKER_ID=worker-1

# --- Google Analytics 4 (servidor; el secreto es secreto) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_USE_PKCE=true

# --- Meta Ads (servidor; el secreto es secreto) ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
# Opcional (Facebook Login for Business): ID de configuración; sustituye al parámetro scope.
META_LOGIN_CONFIG_ID=
META_ASYNC_POLL_TIMEOUT_MS=600000

# --- Correo para invitaciones (servidor). Sin esto, la app muestra el enlace para compartir manualmente. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
